# 复制本文件为 backend/.env 后按需修改；.env 已被 .gitignore 忽略，禁止提交真实值
DATABASE_URL=postgresql+psycopg://waynote:CHANGE_ME@localhost:5432/waynote

# JWT 签名密钥：必须使用随机值
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# 日志（可选，均有默认值；详见 .deepcode/ADR-20260929-Waynote-logging-and-error-handling.md）
# LOG_LEVEL=INFO            # DEBUG / INFO / WARNING / ERROR
# LOG_TO_FILE=true          # 是否写文件（测试环境自动关闭）
# LOG_DIR=logs              # 相对 backend/ 的目录，或绝对路径
# LOG_RETENTION_DAYS=14     # 保留天数：每日轮转时自动删除过期文件
# LOG_COLOR=auto            # auto / always / never（控制台高亮）
# LOG_SLOW_REQUEST_MS=800   # 慢请求高亮阈值
