# 复制本文件为 backend/.env 后按需修改；.env 已被 .gitignore 忽略，禁止提交真实值
DATABASE_URL=postgresql+psycopg://waynote:CHANGE_ME@localhost:5432/waynote

# JWT 签名密钥：必须使用随机值
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# 日志（可选，均有默认值；详见 .deepcode/ADR-20260929-Waynote-logging-and-error-handling.md）
# LOG_LEVEL=INFO            # DEBUG / INFO / WARNING / ERROR
# LOG_TO_FILE=true          # 是否写文件（测试环境自动关闭）
# LOG_DIR=logs              # 相对 backend/ 的目录，或绝对路径
# LOG_RETENTION_DAYS=14     # 保留天数：每日轮转时自动删除过期文件
# LOG_COLOR=auto            # auto / always / never（控制台高亮）
# LOG_SLOW_REQUEST_MS=800   # 慢请求高亮阈值
# LOG_MAX_BYTES=10485760    # 单文件大小上限（0=不限制；与每日轮转取先到者）

# 信任边界与安全（详见 .deepcode/ADR-20260929-Waynote-trust-boundary-hardening.md）
# 仅当直连对端在此白名单内才采信 X-Forwarded-For（生产：反代与后端同机 → 127.0.0.1）
# 严禁填写公网网段或 0.0.0.0/0，否则限流与审计 IP 均可被伪造
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# ALLOW_REGISTRATION=true   # 关闭后 /auth/register 返回 403；注册现在需要邮箱验证码（见下方 SMTP 段）

# 邮箱验证码与 SMTP（详见 .deepcode/ADR-20261009-Waynote-email-code-auth.md）
# 留空不影响启动，但「获取验证码」接口会明确返回 503（不静默降级、不假成功）
# 163 邮箱：邮箱设置 → 开启 POP3/SMTP/IMAP 服务 → 生成「客户端授权码」（不是登录密码）
#   SMTP_HOST=smtp.163.com / SMTP_PORT=465（SSL）/ SMTP_STARTTLS=false
#   注意：163 要求发件人地址与账号一致（SMTP_FROM 留空即用 SMTP_USER）
# 其它常见：QQ 邮箱 smtp.qq.com:465；企业邮箱多为 587 + STARTTLS=true
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_STARTTLS=false
# SMTP_TIMEOUT_SECONDS=10
# SMTP_USER=you@163.com
# SMTP_PASSWORD=你的客户端授权码
# SMTP_FROM=
# SMTP_FROM_NAME=途笺 WayNote

# 验证码策略（默认值适用于个人项目，一般不用改）
# EMAIL_CODE_TTL_MINUTES=10        # 有效期
# EMAIL_CODE_COOLDOWN_SECONDS=60   # 同一邮箱+用途的重发冷却
# EMAIL_CODE_MAX_ATTEMPTS=5        # 单码最多尝试次数（超限作废）
# EMAIL_CODE_PER_EMAIL_HOUR=5      # 每邮箱每小时
# EMAIL_CODE_PER_EMAIL_DAY=10      # 每邮箱每天
# EMAIL_CODE_PER_IP_HOUR=20        # 每 IP 每小时
# EMAIL_CODE_GLOBAL_HOUR=100       # 全局每小时兜底

# 应用层加固（详见 .deepcode/ADR-20261010-Waynote-auth-rate-limit.md）
# DOCS_ENABLED=false               # 生产默认关：/docs /redoc /openapi.json 不注册；本地开发可设 true
# LOGIN_MAX_FAILURES_PER_IP=10     # 同 IP 密码登录失败上限（挡单点暴力）
# LOGIN_MAX_FAILURES_PER_EMAIL=5   # 同邮箱失败上限（挡分布式针对单账号）
# LOGIN_FAILURE_WINDOW_SECONDS=300 # 以上两个维度的统计窗口（成功登录不记账）

# 图片与媒体存储（详见 .deepcode/ADR-20261012-Waynote-image-upload.md）
# 生产建议独立目录、不放进代码仓库（避免影响 update.sh 的 git 工作区判定）：
# MEDIA_ROOT=/home/ubuntu/waynote-media
# MEDIA_URL_PREFIX=/media          # 对外 URL 前缀（将来接 CDN/COS 时调整）
# MEDIA_MAX_BYTES=4194304          # 单图硬上限（4MB；前端会先压缩）
# MEDIA_MAX_EDGE=2000              # 主图最长边
# MEDIA_THUMB_EDGE=640             # 缩略图最长边
# MEDIA_UPLOAD_PER_DAY=100         # 每用户每日上传次数上限
