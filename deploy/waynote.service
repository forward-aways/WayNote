# 途笺 WayNote · systemd 单元（按实测环境写好，直接复制即可）
#
# 安装：
#   sudo cp deploy/waynote.service /etc/systemd/system/waynote.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now waynote
#
# 设计说明（详见 .deepcode/ADR-20260929-Waynote-deployment-systemd.md）：
# 1) 单 worker —— client_logs 限流是进程内内存桶，多 worker 会让限额按 worker 数翻倍；
# 2) 不加 --proxy-headers —— X-Forwarded-For 由应用中间件按 TRUSTED_PROXY_IPS 白名单处理；
# 3) 端口 8010 —— 同机 8000 已被其它应用占用（换机器时先 `ss -ltnp` 看端口）；
# 4) 后端只监听 127.0.0.1，由 Nginx 反代对外，切勿把端口暴露到公网。
[Unit]
Description=Waynote API (FastAPI + uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai-project/WayNote/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/ai-project/WayNote/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
